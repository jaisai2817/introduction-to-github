def rotate_360(vehicle):
    print("Rotating 360 degrees for fire detection")
    msg = vehicle.message_factory.command_long_encode(
        0, 0, mavutil.mavlink.MAV_CMD_CONDITION_YAW,
        0, 360, 30, 1, 0, 0, 0, 0
    )
    vehicle.send_mavlink(msg)
    vehicle.flush()


# Fire detection
def fire_detection():
    fire_model = YOLO('fire.pt')  # Load the fire detection model
    cap = cv2.VideoCapture(0)

    start_time = time.time()
    while time.time() - start_time < 12:  # Allow 12 seconds for 360-degree rotation
        ret, frame = cap.read()
        if not ret:
            break
        results = fire_model.predict(frame)
        for result in results:
            for box in result.boxes:
                confidence = math.ceil(box.conf[0] * 100)
                if confidence > 50:
                    x1, y1, x2, y2 = map(int, box.xyxy[0])
                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 0, 255), 2)
                    cvzone.putTextRect(frame, f'Fire {confidence}%', (x1, y1 - 10))

        cv2.imshow('Fire Detection', frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

