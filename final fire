def send_command(command):
    ser.write(command.encode() + b'\r\n')
    time.sleep(1)
    response = ser.read_all().decode()
    return response

def setup_sim800l():
    send_command('AT')
    send_command('AT+CMGF=1')  # Set SMS to text mode
    send_command('AT+CNMI=1,2,0,0,0')  # Enable message notifications

def read_serial():
